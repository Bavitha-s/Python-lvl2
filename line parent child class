'''
Line: 
properties (variables): 
- length 
method (functions): 
- get_length() 

Square: 
properties (variables): 
- area 
- permieter 
methods (functions): 
- calculate_area() -> and update area variable 
- calculate_perimeter() -> updates permieter 

Cuboid: 
properties (variable): 
- surface area =  6 * area of square  
- volume = length ** 3 
methods (functions): 
- calculate_surface_area() 
- calculate_volume() 

'''
class Line:
    def __init__(self, length):
        self.length = length

    def get_length(self):
        return self.length


class Square(Line):
    def __init__(self, length):
        super().__init__(length)
        self.area = 0
        self.perimeter = 0

    def calculate_area(self):
        self.area = self.length ** 2

    def calculate_perimeter(self):
        self.perimeter = 4 * self.length


class Cuboid(Square):
    def __init__(self, length):
        super().__init__(length)
        self.surface_area = 0
        self.volume = 0

    def calculate_surface_area(self):
        self.calculate_area()
        self.surface_area = 6 * self.area

    def calculate_volume(self):
        self.volume = self.length ** 3


# Main Program
c1 = Cuboid(5)

c1.calculate_area()
c1.calculate_perimeter()
c1.calculate_surface_area()
c1.calculate_volume()

print("Length:", c1.get_length())
print("Area:", c1.area)
print("Perimeter:", c1.perimeter)
print("Surface Area:", c1.surface_area)
print("Volume:", c1.volume)
