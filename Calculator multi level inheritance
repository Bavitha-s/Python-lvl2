# Multi level Inheritence
class CalculatorV1:
    def __init__(self):
        self.num1 = 0
        self.num2 = 0

    def add(self):
        return self.num1 + self.num2

    def sub(self):
        return self.num1 - self.num2

    def division(self):
        return self.num1 / self.num2

    def multiplication(self):
        return self.num1 * self.num2


class CalculatorV2(CalculatorV1):  # inherits from Calculator
    def __init__(self): 
        super().__init__()
        
    def power(self):
        return self.num1 ** self.num2

    def modulo_division(self):
        return self.num1 % self.num2

class CalculatorV3(CalculatorV2): 
    def __init__(self):
        super().__init__()
    def avg(self): 
        return (self.num1+self.num2)/2 
    def get_min(self): 
        return self.num1 if self.num1 < self.num2 else self.num2 
    def get_max(self): 
        return self.num1 if self.num1 > self.num2 else self.num2 
        
calc = CalculatorV3()

calc.num1 = 10
calc.num2 = 3

