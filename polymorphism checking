class Square:
    def __init__(self, length):
        self.length = length

    def __str__(self):
        return f"Square(length={self.length})"

    def __eq__(self, other):
        return self.length == other.length

    def __ne__(self, other):
        return self.length != other.length

    def __lt__(self, other):
        return self.length < other.length

    def __gt__(self, other):
        return self.length > other.length

    def __le__(self, other):
        return self.length <= other.length

    def __ge__(self, other):
        return self.length >= other.length


class Rectangle:
    def __init__(self, length, breadth):
        self.length = length
        self.breadth = breadth

    def __str__(self):
        return f"Rectangle(length={self.length}, breadth={self.breadth})"

    def __eq__(self, other):
        return self.length == other.length and self.breadth == other.breadth

    def __ne__(self, other):
        return self.length != other.length or self.breadth != other.breadth

    def __lt__(self, other):
        return self.length < other.length

    def __gt__(self, other):
        return self.length > other.length

    def __le__(self, other):
        return self.length <= other.length

    def __ge__(self, other):
        return self.length >= other.length


class Circle:
    def __init__(self, radius):
        self.radius = radius

    def __str__(self):
        return f"Circle(radius={self.radius})"

    def __eq__(self, other):
        return self.radius == other.radius

    def __ne__(self, other):
        return self.radius != other.radius

    def __lt__(self, other):
        return self.radius < other.radius

    def __gt__(self, other):
        return self.radius > other.radius

    def __le__(self, other):
        return self.radius <= other.radius

    def __ge__(self, other):
        return self.radius >= other.radius


# Objects
square1 = Square(10)
square2 = Square(20)

rectangle1 = Rectangle(10, 20)
rectangle2 = Rectangle(15, 20)

circle1 = Circle(5)
circle2 = Circle(10)


# Comparisons
print(square1 == square2)   # False
print(square1 != square2)   # True
print(square1 < square2)    # True
print(square1 > square2)    # False
print(square1 <= square2)   # True
print(square1 >= square2)   # False

print(rectangle1 == rectangle2)  # False
print(rectangle1 != rectangle2)  # True
print(rectangle1 < rectangle2)   # True
print(rectangle1 > rectangle2)   # False
print(rectangle1 <= rectangle2)  # True
print(rectangle1 >= rectangle2)  # False

print(circle1 == circle2)   # False
print(circle1 != circle2)   # True
print(circle1 < circle2)    # True
print(circle1 > circle2)    # False
print(circle1 <= circle2)   # True
print(circle1 >= circle2)   # False
