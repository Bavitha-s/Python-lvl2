def display(sequence):
    for step in sequence:
        print(step,end=" ")
    print()
def solve(sequence,current_steps,total_steps):
    if current_steps == total_steps:
        solutions.append(sequence.copy())
        print("valid")
        return
    elif current_steps > total_steps:
        print("Invalid")
        return 
    else:
        # sequence.append(1)
        # display(sequence)
        # solve(sequence,total_steps-1)
        # # 1. when you reach the nth step 
        # # 2. when you didn't reach the nth step 
        # sequence.pop() # remove last step from the sequence 
        # sequence.append(2)
        # display(sequence)
        # solve(sequence,total_steps-2)
        # sequence.pop()
        for step in range(1,3): # 1-3 so we can use 2 as 3 doesnt count
            sequence.append(step)
            display(sequence) # display each step
            solve(sequence,current_steps+step,total_steps)
            sequence.pop()
solutions = [] 
solve([],0,4)
print(solutions)
